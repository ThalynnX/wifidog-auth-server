<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WiFi 认证</title>
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
  <div class="card">
    <h1>WiFi 认证</h1>
    <p class="subtitle">请输入账号密码连接网络</p>

    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <form method="POST" action="/portal" autocomplete="off">
      <input type="hidden" name="ip" value="<%= ip %>">
      <input type="hidden" name="mac" value="<%= mac %>">
      <input type="hidden" name="token" value="<%= token %>">
      <input type="hidden" name="ssid" value="<%= ssid %>">
      <input type="hidden" name="gateway_id" value="<%= gateway_id %>">
      <input type="hidden" name="gateway_address" value="<%= gateway_address %>">

      <div class="form-group">
        <label for="username">用户名</label>
        <input type="text" id="username" name="username" required autofocus autocomplete="username">
      </div>
      <div class="form-group">
        <label for="password">密码</label>
        <input type="password" id="password" name="password" required autocomplete="current-password">
      </div>
      <button type="submit">登录</button>
    </form>

    <div class="info">
      <div class="info-row"><span>设备 MAC</span><span><%= mac %></span></div>
      <div class="info-row"><span>设备 IP</span><span><%= ip %></span></div>
      <% if (ssid) { %>
        <div class="info-row"><span>网络</span><span><%= ssid %></span></div>
      <% } %>
    </div>
  </div>
</body>
</html>
