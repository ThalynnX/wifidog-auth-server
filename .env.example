# ── Server ─────────────────────────────────────────────────
NODE_ENV=production
HOST=0.0.0.0
PORT=2060
AUTH_SERVER_URL=http://1.13.168.245:2060

# ── RADIUS (FreeRADIUS backend) ───────────────────────────
RADIUS_SERVER_HOST=127.0.0.1
RADIUS_SERVER_PORT=1812
RADIUS_SECRET=wifidog_radius_secret_change_me
RADIUS_NAS_IP=127.0.0.1
RADIUS_NAS_PORT=0
RADIUS_TIMEOUT_MS=5000
RADIUS_RETRIES=2

# ── Database ──────────────────────────────────────────────
DB_PATH=./data/wifidog.db
DB_FLUSH_INTERVAL_MS=500

# ── Session / token ────────────────────────────────────────
TOKEN_EXPIRY=3600
GW_CHECK_INTERVAL=600

# ── Brute-force protection ────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10

# ── Gateway (路由器端配置提示) ──────────────────────────────
DEFAULT_GATEWAY_ADDRESS=192.168.6.1
DEFAULT_GATEWAY_ID=jdcloud_re_ss_01

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=info
