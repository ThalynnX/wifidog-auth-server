# =============================================================
#  WiFiDog 认证服务端 - 环境变量配置模板
#  使用：cp .env.example .env，替换 <...> 占位符为真实值
#        修改后 systemctl restart wifidog
#  优先级：后台「系统设置」 > 本文件 > 代码默认值
#  短信/支付密钥只从本文件读取，不写入数据库
# =============================================================

# ---------- 运行模式 ----------
# test       测试模式：短信 mock（验证码回显）、支付走 /portal/pay/mock
# production 正式模式：走真实短信/支付；mock 确认接口关闭；未登记网关不入库
WIFIDOG_RUN_MODE=test

# ---------- 安全 ----------
# JWT 签名密钥。留空则首次启动自动生成到 data/.secret_key（生产建议显式配置）
# WIFIDOG_SECRET=

# ---------- 服务监听（Gunicorn） ----------
# 只监听本机，由 Nginx 反代对外；切勿直接暴露 0.0.0.0
WIFIDOG_BIND=127.0.0.1:8000
# SQLite 部署建议 1~2 个 worker（内存限流按进程计）
WIFIDOG_WORKERS=2
WIFIDOG_LOG_LEVEL=info
# 网关统计上报密钥（请求头 x-gw-key）；只放在 .env，不要提交仓库
WIFIDOG_GWSTATS_KEY=<your-gwstats-key>

# ---------- 数据库 ----------
# 默认 SQLite：sqlite:///data/wifidog.db
# MySQL 示例：mysql+pymysql://wifidog:密码@127.0.0.1:3306/wifidog?charset=utf8mb4
# WIFIDOG_DB_URL=sqlite:///data/wifidog.db
WIFIDOG_DB_ECHO=0

# ---------- Cookie / 网关安全 ----------
# 生产 HTTPS 必须为 1；本地 HTTP 调试可设 0。默认按 PUBLIC_BASE 是否 https 自动判断。
# WIFIDOG_COOKIE_SECURE=1
# 网关 WebSocket 是否强制要求 Device.secret；生产启用前需在路由器 ws path 加 ?secret=...
# WIFIDOG_WS_REQUIRE_SECRET=0
# 可选：只允许这些来源 IP/CIDR 连接网关 WS，逗号分隔
# WIFIDOG_WS_ALLOW_IPS=1.2.3.4,10.0.0.0/8
# 仅信任这些反向代理传来的 X-Forwarded-For；默认只信任本机 Nginx
# WIFIDOG_TRUSTED_PROXIES=127.0.0.1,::1

# ---------- 站点 ----------
WIFIDOG_SITE_NAME=WiFi 认证服务
# 对外基地址，用于生成回调/跳转地址，如 https://portal.example.com
WIFIDOG_PUBLIC_BASE=
# 跳转网关认证接口所用协议：http（绝大多数网关）或 https
WIFIDOG_GATEWAY_PROTO=http

# ---------- 新设备免费体验 ----------
# 0 表示关闭免费体验
WIFIDOG_FREE_TRIAL_MINUTES=10
WIFIDOG_FREE_TRAFFIC_MB=100
# 默认同时在线设备数，0=不限
WIFIDOG_DEVICE_LIMIT=3

# ---------- 会话与令牌 ----------
WIFIDOG_SESSION_IDLE_TIMEOUT=180
WIFIDOG_DEVICE_OFFLINE_TIMEOUT=120
WIFIDOG_ONLINE_WINDOW_SECONDS=120
# 后台 token 有效期（秒），默认 12 小时
WIFIDOG_ADMIN_TOKEN_EXPIRE=43200
# 用户上网 token 有效期（秒），默认 24 小时
WIFIDOG_PORTAL_TOKEN_EXPIRE=86400

# ---------- 短信通道 ----------
# provider: aliyun / http / mock
WIFIDOG_SMS_PROVIDER=mock
WIFIDOG_SMS_ACCESS_KEY=<your-sms-access-key>
WIFIDOG_SMS_SECRET_KEY=<your-sms-secret-key>
WIFIDOG_SMS_SIGN_NAME=<your-sms-sign-name>
WIFIDOG_SMS_TEMPLATE_CODE=<your-template-code>
# 仅隔离测试可设为 1；生产必须为 0（验证码不会在接口/页面回显）
WIFIDOG_SMS_DEV_ECHO=0
WIFIDOG_SMS_CODE_EXPIRE=300
WIFIDOG_SMS_DAILY_LIMIT=20
WIFIDOG_SMS_IP_HOURLY_LIMIT=10

# ---------- 支付通道 ----------
# provider: alipay / wechat / mock
# 注意：同时配置多个通道时，以 WIFIDOG_PAY_PROVIDER 为准
WIFIDOG_PAY_PROVIDER=mock

# 支付宝（RSA2）
WIFIDOG_ALIPAY_APPID=<your-alipay-appid>
# PEM 多行文本可用 \n 转义写成单行
WIFIDOG_ALIPAY_PRIVATE_KEY=
WIFIDOG_ALIPAY_PUBLIC_KEY=
WIFIDOG_ALIPAY_NOTIFY_URL=https://portal.example.com/portal/api/pay/notify/alipay

# 微信支付 APIv3（验签使用“微信支付公钥”，不是商户平台证书）
WIFIDOG_WECHAT_APPID=<your-wechat-appid>
WIFIDOG_WECHAT_MCHID=<your-wechat-mchid>
WIFIDOG_WECHAT_API_V3=<your-apiv3-key>
# 商户 API 证书序列号（请求签名用）
WIFIDOG_WECHAT_SERIAL_NO=<your-merchant-cert-serial>
# 商户 API 证书私钥；支持 base64: 单行
WIFIDOG_WECHAT_PRIVATE_KEY=
# 微信支付公钥 PEM；支持 base64: 单行
WIFIDOG_WECHAT_PUBLIC_KEY=
# 微信支付公钥 ID（PUB_KEY_ID_ 开头；启用公钥模式后必填）
WIFIDOG_WECHAT_PUBLIC_KEY_ID=
# 灰度期兼容平台证书签名：当前平台证书 PEM 与序列号（可选；切换完成后可移除）
WIFIDOG_WECHAT_PLATFORM_CERT=
WIFIDOG_WECHAT_PLATFORM_SERIAL=
WIFIDOG_WECHAT_NOTIFY_URL=https://portal.example.com/portal/api/pay/notify/wechat

# ---------- 调试 ----------
WIFIDOG_DEBUG=0

# 多 worker WebSocket 总线（Redis 仅监听 127.0.0.1）
WIFIDOG_REDIS_URL=redis://127.0.0.1:6379/0
