# ── Server ─────────────────────────────────────────────────────────
NODE_ENV=development            # production | development
HOST=0.0.0.0
PORT=2060

# Public URL of this auth server (used in docs / links)
AUTH_SERVER_URL=http://your-server-ip:2060

# ── RADIUS (FreeRADIUS backend) ────────────────────────────────────
RADIUS_SERVER_HOST=127.0.0.1    # in docker-compose: freeradius
RADIUS_SERVER_PORT=1812
RADIUS_SECRET=testing123        # MUST change in production; must match freeradius/clients.conf
RADIUS_NAS_IP=127.0.0.1
RADIUS_NAS_PORT=0
RADIUS_TIMEOUT_MS=5000
RADIUS_RETRIES=2

# ── Database ───────────────────────────────────────────────────────
DB_PATH=./data/wifidog.db
DB_FLUSH_INTERVAL_MS=500        # debounce before persisting DB to disk (ms)

# ── Session / token ────────────────────────────────────────────────
TOKEN_EXPIRY=3600               # seconds
GW_CHECK_INTERVAL=600           # seconds between expired-token cleanup runs

# ── Brute-force protection (portal login) ──────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10

# ── Logging ────────────────────────────────────────────────────────
LOG_LEVEL=info                  # debug | info | warn | error
